pipeline {
    agent any

    stages {
        stage('Checkout') {
            when {
                branch 'test'
            }
            steps {
                git 'https://github.com/vishnu-p2f/OpenROAD.git'
                sh 'git submodule update --init --recursive'
            }
        }

        stage('Build') {
            when {
                branch 'test'
            }
            steps {
                sh '''
                    ./etc/DependencyInstaller.sh
                    mkdir -p build
                    cd build
                    cmake ..
                    make -j$(nproc)
                '''
            }
        }

        stage('Run Tests & Save Log') {
            when {
                branch 'test'
            }
            steps {
                sh '''
                    cd build
                    ctest --output-on-failure | tee test_output.log
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'build/test_output.log', fingerprint: true
        }
    }
}
