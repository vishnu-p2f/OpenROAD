pipeline {
    agent any

    environment {
        GIT_SSH_COMMAND = 'ssh -i ~/.ssh/id_ed25519_jenkins -o StrictHostKeyChecking=no'
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    // Create Dockerfile dynamically or use a file in repo
                    writeFile file: 'Dockerfile', text: '''
                    FROM ubuntu:22.04

                    RUN apt-get update && apt-get install -y \\
                        git \\
                        openssh-client \\
                        build-essential \\
                        cmake \\
                        ninja-build \\
                        ctest \\
                        python3 \\
                        sudo \\
                        wget \\
                        curl \\
                        && rm -rf /var/lib/apt/lists/*

                    # Optional: add more setup here
                    '''
                    // Build the image
                    docker.build('openroad-build-env:latest')
                }
            }
        }

        stage('Run Build & Test inside Docker') {
            steps {
                script {
                    docker.image('openroad-build-env:latest').inside('--user root') {
                        sh '''
                            eval "$(ssh-agent -s)"
                            ssh-add ~/.ssh/id_ed25519_jenkins

                            if [ -d "source" ]; then
                                cd source
                                git fetch origin
                                git reset --hard origin/test
                                git submodule sync --recursive
                                git submodule update --init --recursive
                            else
                                git clone --recurse-submodules git@github.com:vishnu-p2f/OpenROAD.git source
                            fi

                            cd source
                            ./etc/DependencyInstaller.sh -base
                            ./etc/DependencyInstaller.sh -common -local

                            ./etc/Build.sh -cmake="-DCMAKE_BUILD_TYPE=RELEASE"

                            cd build
                            ctest --output-on-failure | tee test_output.log
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'source/build/test_output.log', allowEmptyArchive: true
            archiveArtifacts artifacts: 'source/build/openroad_build.log', allowEmptyArchive: true
        }
    }
}
