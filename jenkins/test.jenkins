pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Clone main repo using SSH
                git 'git@github.com:vishnu-p2f/OpenROAD.git'

                // Sync and update submodules using SSH URLs from .gitmodules
                sh '''
                    git submodule sync --recursive
                    git submodule update --init --recursive
                '''
            }
        }

        stage('Build') {
            when {
                branch 'test'
            }
            steps {
                sh '''
                    ./etc/DependencyInstaller.sh
                    mkdir -p build
                    cd build
                    cmake ..
                    make -j$(nproc)
                '''
            }
        }

        stage('Run Tests & Save Log') {
            when {
                branch 'test'
            }
            steps {
                sh '''
                    cd build
                    ctest --output-on-failure | tee test_output.log
                '''
            }
        }
    }

    post {
        always {
            script {
                if (fileExists('build/test_output.log')) {
                    archiveArtifacts artifacts: 'build/test_output.log', fingerprint: true
                } else {
                    echo "No test_output.log found, skipping archive."
                }
            }
        }
    }
}
