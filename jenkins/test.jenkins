pipeline {
    agent any

    environment {
        GIT_SSH_COMMAND = 'ssh -i ~/.ssh/id_ed25519_jenkins -o StrictHostKeyChecking=no'
    }

    stages {
        stage('Clone Repo & Submodules') {
            steps {
                sh '''
                    eval "$(ssh-agent -s)"
                    ssh-add ~/.ssh/id_ed25519_jenkins

                    # Clone with SSH
                    git clone --recurse-submodules git@github.com:vishnu-p2f/OpenROAD.git source
                    cd source
                    git submodule sync --recursive
                    git submodule update --init --recursive
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    cd source
                    sudo ./etc/DependencyInstaller.sh -base
                    ./etc/DependencyInstaller.sh -common -local
                '''
            }
        }

        stage('Build OpenROAD') {
            steps {
                sh '''
                    cd source
                    ./etc/Build.sh -cmake="-DCMAKE_BUILD_TYPE=RELEASE"
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    cd source/build
                    ctest --output-on-failure | tee test_output.log
                '''
            }
        }
    }

    post {
        always {
            script {
                def logPath = 'source/build'
                def testLog = "${logPath}/test_output.log"
                def buildLog = "${logPath}/openroad_build.log"
                if (fileExists(testLog)) {
                    archiveArtifacts artifacts: "${testLog}", fingerprint: true
                }
                if (fileExists(buildLog)) {
                    archiveArtifacts artifacts: "${buildLog}", fingerprint: true
                }
            }
        }
    }
}
