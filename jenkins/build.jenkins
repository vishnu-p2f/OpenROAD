pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh '''
                    git clone git@github.com:vishnu-p2f/OpenROAD.git source
                    cd source
                    ./etc/DependencyInstaller.sh -base
                    ./etc/Build.sh -cmake="-DCMAKE_BUILD_TYPE=RELEASE"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'source/build/**', fingerprint: true
        }
    }
}
